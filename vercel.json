{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/cms(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-publish",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/instagram.js": {
      "maxDuration": 60
    },
    "api/cron-publish.js": {
      "maxDuration": 60
    },
    "api/inspect.js": {
      "maxDuration": 20
    },
    "api/ideas.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 20
    },
    "api/zettel.js": {
      "maxDuration": 60
    },
    "api/event.js": {
      "maxDuration": 10
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/billing.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/portal",
      "destination": "/api/billing?op=portal"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/billing?op=checkout"
    },
    {
      "source": "/api/ads",
      "destination": "/api/admin?op=ads"
    },
    {
      "source": "/api/catalog-gen",
      "destination": "/api/admin?op=catalog"
    },
    {
      "source": "/api/draft",
      "destination": "/api/admin?op=draft"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/admin?op=integrations"
    }
  ]
}