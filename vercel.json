{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/cms(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-publish",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/instagram.js": {
      "maxDuration": 60
    },
    "api/cron-publish.js": {
      "maxDuration": 60
    },
    "api/ads.js": {
      "maxDuration": 30
    },
    "api/draft.js": {
      "maxDuration": 60
    },
    "api/inspect.js": {
      "maxDuration": 20
    },
    "api/ideas.js": {
      "maxDuration": 60
    },
    "api/zettel.js": {
      "maxDuration": 60
    },
    "api/event.js": {
      "maxDuration": 10
    }
  }
}